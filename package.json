{
	"name": "companion-module-livemotion-livematrix",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Bitfocus Companion module for LiveMotion LiveMatrix",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-livemotion-livematrix.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-livemotion-livematrix/issues"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"companion"
	],
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"build": "rimraf dist && tsc --project tsconfig.build.json",
		"watch": "tsc --project tsconfig.build.json --watch",
		"package": "run build && companion-module-build",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run"
	},
	"engines": {
		"node": "^22.20 || ^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "^2.1.3",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.19.3",
		"@types/ws": "^8.18.1",
		"eslint": "^10.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.51.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"license": "MIT",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
